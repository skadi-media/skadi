# Rust
/target/
**/*.rs.bk
Cargo.lock

# skadi-web (Leptos CSR) build output — generated by `trunk build`, embedded
# into the daemon at compile time; never committed.
/crates/skadi-web/dist/
/crates/skadi-web/target/
/crates/skadi-web/Cargo.lock

# skadi-downloader-worker (embeds librqbit) — separate deployable, excluded from
# the workspace; its build artifacts aren't committed.
/crates/skadi-downloader-worker/target/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Test artifacts
/tmp/
/test-results/

# Database files
*.db
*.db-shm
*.db-wal

# Coverage reports
/coverage/
tarpaulin-report.html
cobertura.xml
lcov.info

# Build artifacts
**/*.orig

# Metis ephemeral state
.metis/.index-dirty

# Documentation build output
/site/

# Environment
.env
.env.local

parser-test-cases.txt
config.txt

# Design handoff upload (local reference; see SKADI-I-0035)
Unified ARR stack replacement.zip

# Cardigann definitions synced/seeded at runtime (SKADI-I-0036)
/definitions/

# Local key material (e.g. the parked auto-update signing key) — never commit.
/release-keys/
deploy/apk/

# Lab stack local storage (angreal lab, SKADI-T-0393)
deploy/.lab/
# NAS site config (angreal nas): host, user, uid — personal, keep out of git
deploy/.env.nas
# DB dumps from `angreal nas db-migrate`
deploy/.nas-dump/
# Pre-deploy database dumps (SKADI-T-0481). Real library data — never committed.
deploy/.backups/
# Emulator screenshots (SKADI-T-0571). They show whatever library the server has,
# so against a real one they contain real titles and covers — never committed.
clients/skadi-android/build/shots/
.claude/metis-ralph-active.yaml

# Any .env sidecar, not just the bare name. A cut-over backup called
# deploy/.env.before-cutover was committed and pushed to a PUBLIC repo on
# 2026-09-24 because the ignore rule matched `deploy/.env` exactly and a
# `git add -A` swept the backup up. Every credential in it was rotated.
deploy/.env.*
!deploy/.env.*.example
