# Copy to keystore.properties (gitignored) for release signing.
# Generate the keystore with:
#   keytool -genkeypair -v -keystore keystore/skadi-release.jks -alias skadi \
#     -keyalg RSA -keysize 2048 -validity 10000
storeFile=keystore/skadi-release.jks
storePassword=CHANGE_ME
keyAlias=skadi
keyPassword=CHANGE_ME
