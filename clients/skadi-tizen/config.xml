<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns:tizen="http://tizen.org/ns/widgets" xmlns="http://www.w3.org/ns/widgets" id="https://github.com/skadi-media/skadi/tizen" version="0.1.0" viewmodes="maximized">
    <!-- The server is on the home network at an address the user types in. -->
    <access origin="*" subdomains="true"></access>
    <!-- The package id must be exactly 10 characters. -->
    <tizen:application id="SkadiTizen.Skadi" package="SkadiTizen" required_version="2.3"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <name>Skadi</name>
    <description>Skadi for Samsung Smart TV.</description>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:profile name="tv"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
