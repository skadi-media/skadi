# Copy to deploy/.env.nas (gitignored) and fill in. Overrides applied ON TOP of deploy/.env when `angreal nas push` assembles the
# NAS's .env (SKADI-I-0056). Keys here win. No secrets — those stay in .env.
# Site-specific, gitignored; see docker-compose.nas.yml for what each does.

# ssh target (Container Manager host). NAS_DOCKER is the docker command there
# ("docker" if the ssh user is in the docker group, "sudo docker" otherwise).
NAS_SSH_HOST=<nas-ip-or-hostname>
NAS_SSH_PORT=22
NAS_SSH_USER=<ssh-user>
# DSM has no `docker` group and the socket is root:root 660, so sudo it is
# (needs the NOPASSWD sudoers line from deploy/README "Running on the NAS").
# Full path: non-interactive ssh has no /usr/local/bin on PATH.
NAS_DOCKER=sudo /usr/local/bin/docker

# Where the stack lives on the NAS: <NAS_DATA_DIR>/deploy (compose + env + apk),
# <NAS_DATA_DIR>/pg-data, <NAS_DATA_DIR>/cardigann-defs.
NAS_DATA_DIR=/volume1/docker/skadi
NAS_MEDIA_DIR=/volume1/media
# Run the containers as the ssh user: the share is mode 777 so 1027 can write +
# hardlink alongside the NFS-era files (owned 1024:100), and the data dirs under
# NAS_DATA_DIR are created by this user, so nothing needs a chown or sudo.
NAS_PUID=<uid of NAS_SSH_USER, e.g. id -u>
NAS_PGID=100

# Images: GHCR by default (CI publishes main as :latest). For a locally built +
# `angreal nas push --images` image set NAS_IMAGE_PREFIX= (empty) and NAS_IMAGE_TAG=nas.
#NAS_IMAGE_PREFIX=
#NAS_IMAGE_TAG=nas

# Pairing/install QRs must advertise the NAS, not the Mac.
SKADI_ADVERTISE_HOST=<nas-ip>:8090

# Concurrent downloads (SKADI-T-0489). Unset means unlimited, which on this box
# means the worker will happily run whatever the hunter queues: 38 at once
# measured ~1 GiB RSS on cut-over day and pushed a 4 GB NAS into swap. 8 keeps the
# worker near its idle footprint with headroom for postgres, flaresolverr and
# gluetun. Raise it only after watching `angreal nas status` under load.
SKADI_WORKER_MAX_ACTIVE=8
