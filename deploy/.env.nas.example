# Copy to deploy/.env.nas (ignored by version control) and fill in. ssh access
# to the storage host, for the library maintenance scripts that run commands on
# it (deploy/remux-on-nas.py, deploy/cull-unfixable.py). No secrets: those stay
# in deploy/.env.
NAS_SSH_HOST=<nas-ip-or-hostname>
NAS_SSH_PORT=22
NAS_SSH_USER=<ssh-user>
