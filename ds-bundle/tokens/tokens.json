      "ice-tint-soft": { "value": "rgba(127, 178, 255, 0.08)", "comment": "hover fill" }
    }
  },
  "gradient": {
    "aurora":   { "value": "linear-gradient(90deg, #5fd0c5, #7fb2ff, #9d8cff)", "comment": "teal→ice→violet brand sweep" },
