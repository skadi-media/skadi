{
  "$name": "Skadi — Cold Nordic",
  "$description": "Token-first dark design language (SKADI-I-0035). Slate surfaces, an ice/teal/violet aurora accent set, and a gold 'owned/cutoff' accent. Type is IBM Plex Sans (UI) + IBM Plex Mono (numbers, paths, env vars, release titles, timestamps).",
  "color": {
    "surface": {
      "bg":       { "value": "#0e1116", "comment": "app background" },
      "sidebar":  { "value": "#12161c", "comment": "left nav rail" },
