      "panel-2":  { "value": "#13171e", "comment": "nested/secondary panel" },
      "inset":    { "value": "#0a0c10", "comment": "recessed wells, code blocks" },
      "control":  { "value": "#1b2129", "comment": "buttons, inputs, chips" }
    },
    "border": {
      "border":         { "value": "#232a34", "comment": "default divider" },
      "border-soft":    { "value": "#1d232c" },
      "border-fainter": { "value": "#15191f" },
      "border-control": { "value": "#2a3340", "comment": "control outlines" }
    },
    "text": {
      "fg":        { "value": "#e6e9ee", "comment": "body" },
      "fg-bright": { "value": "#f1f4f8", "comment": "headings, emphasis" },
      "fg-2":      { "value": "#c3cbd5", "comment": "secondary body" },
