  },
  "font": {
    "sans": { "value": "\"IBM Plex Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif", "comment": "UI text" },
    "mono": { "value": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, monospace", "comment": "numbers, paths, env vars, release titles, timestamps, technical labels" }
  },
  "fontWeight": {
    "regular":  { "value": 400 },
    "medium":   { "value": 500 },
    "semibold": { "value": 600 },
    "bold":     { "value": 700, "comment": "sans only" }
  },
  "radius": {
    "tile": { "value": "8px" },
    "card": { "value": "10px" },
    "pill": { "value": "20px" }
  }
