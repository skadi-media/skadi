      "violet":       { "value": "#9d8cff" },
      "gold":         { "value": "#d8a657", "comment": "'owned/cutoff' accent" }
    },
    "semantic": {
      "ok":   { "value": "#4bd07f" },
      "warn": { "value": "#d8a657" },
      "bad":  { "value": "#f06464" }
    },
    "tint": {
